# Copy to .env.local (git ignored) and fill in.
# MySQL 8 connection either as one URL or as discrete values.
DATABASE_URL=mysql://root:password@127.0.0.1:3306/fujue_platform
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=fujue_platform

# Public origin of this deployment. Leave empty to derive it from the request.
PLATFORM_ORIGIN=http://localhost:3000

# Deployment-wide fallback upstream. The OpenAI-compatible root serves
# /chat/completions and also answers the desktop's Anthropic route through
# translation. Set DEEPSEEK_ANTHROPIC_BASE_URL only when the default provider
# itself speaks Anthropic; leaving it empty keeps every request on the OpenAI
# protocol.
DEEPSEEK_UPSTREAM_URL=https://api.deepseek.com
DEEPSEEK_ANTHROPIC_BASE_URL=
DEEPSEEK_API_KEY=

# Manual recharge destination rendered by /top_up. Without a bank name and
# account number the page only tells the visitor to contact the administrator.
PLATFORM_BANK_NAME=
PLATFORM_BANK_ACCOUNT=
PLATFORM_BANK_HOLDER=
PLATFORM_TOPUP_NOTE=

# Session cookie hardening; production deployments must serve HTTPS.
NODE_ENV=development

# Owner account created by `npm run db:init`. The password is written only when
# the account does not exist yet.
PLATFORM_ADMIN_EMAIL=quyetguic@gmail.com
PLATFORM_ADMIN_PASSWORD=quyet12345
PLATFORM_ADMIN_NAME=QuyetGuic
